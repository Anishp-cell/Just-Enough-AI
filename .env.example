# Nebius Token Factory Configuration
NEBIUS_API_KEY=your_nebius_api_key_here
NEBIUS_BASE_URL=https://api.studio.nebius.ai/v1

# Models
MODEL_NANO=nvidia/nemotron-3-nano-omni
MODEL_SUPER=nvidia/nemotron-3-super-120b-a12b
MODEL_ULTRA=nvidia/Llama-3_1-Nemotron-Ultra-253B-v1

# Local Hardware Profiling
ENABLE_GPU_PROFILING=true
VRAM_THRESHOLD_MB=6144

# devmind Codebase Memory Bridge
DEVMIND_ENABLED=true
DEVMIND_CLI_PATH=devmind

# Execution Mode
MOCK_MODE=true
LOG_LEVEL=INFO
